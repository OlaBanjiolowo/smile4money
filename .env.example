STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

CONTRACT_ESCROW=
CONTRACT_ORACLE=

LICHESS_API_TOKEN=
CHESSDOTCOM_API_KEY=

# Oracle signing key — never commit a real value; load from a secrets manager in production
ORACLE_SECRET_KEY=

# Comma-separated list of allowed CORS origins
# e.g. https://app.example.com,https://staging.example.com
# Falls back to FRONTEND_URL if set, otherwise defaults to http://localhost:5173
ALLOWED_ORIGINS=
FRONTEND_URL=

VITE_STELLAR_NETWORK=testnet
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
